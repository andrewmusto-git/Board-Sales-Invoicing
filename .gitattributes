# Enforce Unix line endings for all scripts and Python files
# This prevents CRLF corruption when cloning on Windows and running on Linux.

# Default: normalize line endings in the index to LF
* text=auto

# Explicitly force LF for scripts and code
*.py    text eol=lf
*.sh    text eol=lf
*.env   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Binary files — no line ending normalization
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
