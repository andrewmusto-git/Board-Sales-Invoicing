# ============================================================
# Board Sales Invoicing IBM i / AS400 → Veza OAA Connector
# Environment Configuration Template
# Copy this file to .env and fill in real values.
# chmod 600 .env  (restrict read access — contains credentials)
# ============================================================

# ----------------------------------------------------------
# IBM i / AS400 JDBC Source
# ----------------------------------------------------------

# Full JDBC URL for the IBM i system.
# Format: jdbc:as400://<hostname>/<default-library>;naming=sql;date format=iso
DB_URL=jdbc:as400://your-ibmi-host/PDMSTRDBLB;naming=sql;date format=iso

# IBM i user profile (must have *USE authority to pdmstrdblb library)
DB_USER=your_ibmi_user

# IBM i user profile password
DB_PASSWORD=your_ibmi_password

# Absolute path to the JT400 JAR (IBM Toolbox for Java).
# Download: https://sourceforge.net/projects/jt400/files/
# or Maven: https://repo1.maven.org/maven2/net/sf/jt400/jt400/
JDBC_JAR=/opt/jt400/jt400.jar

# ----------------------------------------------------------
# Veza Configuration
# ----------------------------------------------------------

# Your Veza tenant URL (no trailing slash)
VEZA_URL=https://your-company.veza.com

# Veza API key (generate in Veza Settings → API Keys)
VEZA_API_KEY=your_veza_api_key_here

# ----------------------------------------------------------
# OAA Provider Settings (optional overrides)
# ----------------------------------------------------------
# PROVIDER_NAME=Board Sales Invoicing
# DATASOURCE_NAME=board-sales-invoicing


# Veza API key — generate in Veza Settings → API Keys
VEZA_API_KEY=your_veza_api_key_here

# ----------------------------------------------------------
# OAA Provider / Datasource Labels (optional overrides)
# ----------------------------------------------------------

# Name shown in Veza's provider list
# PROVIDER_NAME=Board Sales Invoicing

# Name shown as the datasource under the provider
# DATASOURCE_NAME=your_ibmi_hostname
